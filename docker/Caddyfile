# app_skeleton reads $_SERVER['REQUEST_URI'] directly (see
# app/bootstrap_web.php) rather than a rewritten _url query param, so
# php_fastcgi's default try_files-then-index.php behaviour is already
# exactly right — no custom rewrite rules needed. Automatic HTTPS is on by
# default for any real domain in {$SITE_DOMAIN}. Caddy also enables it
# (self-signed, with an HTTP->HTTPS redirect) for the bare hostname
# "localhost" specifically — not what local dev/CI curl over plain HTTP
# wants, so their SITE_DOMAIN default is the explicit "http://localhost"
# scheme, which disables automatic HTTPS for that block entirely. Real
# deployments set SITE_DOMAIN to an actual domain (no scheme), which still
# gets full automatic HTTPS as intended.

{$SITE_DOMAIN:http://localhost} {
    root * /app/public
    encode gzip

    # Baseline security headers (project audit, 2026-08-04, Tier 1).
    # script-src has no 'unsafe-inline' — every inline <script> block the
    # AdminLTE views used has been extracted to a static file under
    # public/assets/js/ specifically so this could be dropped rather than
    # left permissive (Session 13). style-src keeps 'unsafe-inline':
    # this app uses inline style="..." attributes throughout the views,
    # and CSP has no equivalent low-effort tightening for those the way
    # it does for <script> blocks (would need per-element nonces/hashes,
    # real effort disproportionate to a "baseline" header pass) — a much
    # lower-risk allowance than unsafe-inline on script-src, since it
    # can't execute arbitrary JS. img-src allows any https: origin (added
    # 2026-10-23): modules show catalogue images hosted elsewhere — the LMS
    # library's cover_url (Open Library covers, OpenStax's SVG book cards)
    # — and an <img> cannot run script, so this widens exposure to a
    # tracking pixel at most. script-src stays 'self' only.
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; frame-ancestors 'none'"
    }

    php_fastcgi {$PHP_FPM_UPSTREAM:app:9000}

    # Project audit Fix Kit, 2026-08-11. Short max-age, not the
    # aggressive `immutable`/1-year form — asset filenames under
    # public/assets/ aren't fingerprinted/versioned on change, so a long
    # cache would serve a stale file after a real deploy until it expires.
    @static path /assets/* /favicon/*
    header @static Cache-Control "public, max-age=3600"

    file_server
}

# xtmk.xten.au: merged into this instance 2026-09-25. It is served by the
# {$SITE_DOMAIN} block above (listed in .env's SITE_DOMAIN), not a block of its own.

# games.xten.au (xten-au/games, minigames) -- third app on Internal
# Prod's shared front door, the same pattern xtmk.xten.au used before the merge: its own
# compose project at /opt/games (app + db only, no caddy of its own),
# reached by container name over edge_shared, static files read from the
# /opt/games/public bind mount declared in docker-compose.prod.yml.
games.xten.au {
    root * /games-public
    encode gzip
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; frame-ancestors 'none'"
    }
    # SPA shell (GX-SPEC-04, MAA-20261026-011): the built frontend lives in public/app; the bare
    # /app and /app/ paths would otherwise fall through to PHP and 404.
    @appindex path /app /app/
    rewrite @appindex /app/index.html

    php_fastcgi games-app-1:9000 {
        root /app/public
    }
    @static path /assets/* /favicon/*
    header @static Cache-Control "public, max-age=3600"
    file_server
}

