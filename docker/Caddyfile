# app_skeleton reads $_SERVER['REQUEST_URI'] directly (see
# app/bootstrap_web.php) rather than a rewritten _url query param, so
# php_fastcgi's default try_files-then-index.php behaviour is already
# exactly right — no custom rewrite rules needed. Automatic HTTPS is on by
# default for any real domain in {$SITE_DOMAIN}. Caddy also enables it
# (self-signed, with an HTTP->HTTPS redirect) for the bare hostname
# "localhost" specifically — not what local dev/CI curl over plain HTTP
# wants, so their SITE_DOMAIN default is the explicit "http://localhost"
# scheme, which disables automatic HTTPS for that block entirely. Real
# deployments set SITE_DOMAIN to an actual domain (no scheme), which still
# gets full automatic HTTPS as intended.

{$SITE_DOMAIN:http://localhost} {
    root * /app/public
    encode gzip

    # Baseline security headers (project audit, 2026-08-04, Tier 1).
    # script-src has no 'unsafe-inline' — every inline <script> block the
    # AdminLTE views used has been extracted to a static file under
    # public/assets/js/ specifically so this could be dropped rather than
    # left permissive (Session 13). style-src keeps 'unsafe-inline':
    # this app uses inline style="..." attributes throughout the views,
    # and CSP has no equivalent low-effort tightening for those the way
    # it does for <script> blocks (would need per-element nonces/hashes,
    # real effort disproportionate to a "baseline" header pass) — a much
    # lower-risk allowance than unsafe-inline on script-src, since it
    # can't execute arbitrary JS.
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'"
    }

    php_fastcgi {$PHP_FPM_UPSTREAM:app:9000}

    file_server
}
