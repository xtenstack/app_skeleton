# Copy to .env and fill in real values — .env is gitignored, this file isn't.
# Only used by docker-compose.yml to fill in DB creds and the site domain;
# the app itself still doesn't read .env directly, see
# app/config/config.local.php (rendered by docker/entrypoint.sh from these
# same values at container start).

DB_NAME=app_skeleton
DB_USER=app_skeleton
DB_PASSWORD=

# Leave unset for local testing (falls back to localhost, self-signed TLS).
# Set to a real domain for Caddy's automatic HTTPS to kick in.
SITE_DOMAIN=

# development (default): display_errors on, opcache revalidates every
# request. production: both off, for real deployments.
APP_ENV=development

# Local dev defaults to non-privileged ports so this doesn't fight
# anything already on :80/:443. Real deployments must use 80/443 exactly
# — Let's Encrypt's challenges require it, automatic HTTPS won't work on
# any other port.
HTTP_PORT=8080
HTTPS_PORT=8443

# Optional — leave all blank to keep the existing behavior (mail() has no
# MTA, send fails silently and logs it, request still succeeds). Set all
# four to relay real mail through an authenticated SMTP account (msmtp,
# see docker/entrypoint.sh) instead. Port 465 = implicit TLS (the default
# here); if your provider uses STARTTLS on 587 instead, entrypoint.sh's
# msmtp config needs updating to match, they aren't interchangeable.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Search Engine Resolver (MAA-20260908-005) -- Brave only for now, Google
# CSE / Bing not yet provisioned. Free tier: 1,000 queries/month.
# Leave blank to disable ./run search-resolve entirely.
BRAVE_API_KEY=

# Dolibarr (MAA-20260908-010, Watson Phase 1 close action) -- a scoped
# Dolibarr API token for the watson.ssa Dolibarr login (Third Party/
# Project/Invoice create rights only), separate from Tim's own token.
# Leave blank to disable the Watson close-offer endpoint.
DOLIBARR_WATSON_TOKEN=
