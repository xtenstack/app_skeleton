{
    "name": "travissaron/app-skeleton",
    "description": "Phalcon 5.8 multi-module skeleton: server-rendered AdminLTE backend + JSON API module, with auth, RBAC, audit logging (with reversal), soft deletes, a cron system, and signup/verification/password-reset flows.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "requirements-module"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-phalcon": "^5.8",
        "ext-pdo_pgsql": "*",
        "ext-openssl": "*",
        "xtenstack/requirements-module": "*"
    },
    "require-dev": {
        "phalcon/devtools": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App_skeleton\\": "app/common/library/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.99"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php bin/install.php"
        ],
        "post-update-cmd": [
            "@php bin/install.php"
        ]
    }
}
