{
    "name": "travissaron/app-skeleton",
    "description": "Phalcon 5.8 multi-module skeleton: server-rendered AdminLTE backend + JSON API module, with auth, RBAC, audit logging (with reversal), soft deletes, a cron system, and signup/verification/password-reset flows.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "ext-phalcon": "^5.8",
        "ext-pdo_pgsql": "*",
        "ext-openssl": "*",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phalcon/devtools": "^5.0",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^10.5",
        "vimeo/psalm": "^5.26.1"
    },
    "autoload": {
        "psr-4": {
            "App_skeleton\\": "app/common/library/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.3.99",
            "ext-phalcon": "5.8.0",
            "ext-pdo_pgsql": "8.3.99"
        },
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ],
            "merge-dev": true,
            "merge-extra": false
        }
    },
    "scripts": {
        "post-install-cmd": [
            "[ -d .githooks ] && git config core.hooksPath .githooks || true",
            "[ -f bin/install.php ] && php bin/install.php || true"
        ],
        "post-update-cmd": [
            "[ -d .githooks ] && git config core.hooksPath .githooks || true",
            "[ -f bin/install.php ] && php bin/install.php || true"
        ],
        "test": "phpunit"
    }
}
