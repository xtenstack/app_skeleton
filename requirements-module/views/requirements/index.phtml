            <select class="form-control form-control-sm" name="status">
              <option value="">— No change —</option>
<?php foreach ($statuses as $value => $label): ?>
<?php if ($value === 'complete') continue; ?>
              <option value="<?= $value ?>"><?= $label ?></option>
<?php endforeach; ?>
            </select>
