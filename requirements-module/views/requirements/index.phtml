              <tr>
                <td><input type="checkbox" class="bulk-row-checkbox" name="requirement_ids[]" value="<?= $requirement->id ?>" aria-label="Select <?= $this->escaper->escapeHtmlAttr($requirement->display_id) ?>"></td>
                <td><?= $this->escaper->escapeHtml($requirement->display_id) ?></td>
                <td><?= $this->escaper->escapeHtml($requirement->title) ?></td>
                <td><span class="badge badge-<?= $requirement->status === 'complete' ? 'success' : ($requirement->status === 'done_pending_changelog_decision' ? 'info' : ($requirement->status === 'in_progress' ? 'warning' : 'secondary')) ?>"><?= $this->escaper->escapeHtml($statuses[$requirement->status] ?? $requirement->status) ?></span></td>
                <td><?= $this->escaper->escapeHtml($requirement->changelog_decision ?: '—') ?></td>
                <td><?= $this->escaper->escapeHtml($requirement->origin_session ?: '—') ?></td>
