                  <button type="submit" formaction="<?= $baseUrl ?>/delete/<?= $requirement->id ?>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete <?= $this->escaper->escapeHtmlAttr($requirement->display_id) ?>?')">Delete</button>
                </td>
              </tr>
<?php endforeach; ?>
<?php if (!count($requirements)): ?>
              <tr>
                <td colspan="8" class="text-center text-muted">No requirements yet.</td>
              </tr>
<?php endif; ?>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</form>

