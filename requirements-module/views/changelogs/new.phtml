<div class="row mb-2">
  <div class="col-12">
    <h1>New changelog</h1>
  </div>
</div>

<div class="row">
  <div class="col-12 col-md-6">
    <div class="card">
      <div class="card-body">
        <form method="post" action="<?= $this->url->get('requirements/changelogs/create') ?>">
          <div class="form-group">
            <label for="version">Version</label>
            <input type="text" class="form-control" id="version" name="version" value="<?= $this->escaper->escapeHtml((string) $changelog->version) ?>" placeholder="e.g. 1.4.0" required>
          </div>
          <div class="form-group">
            <label for="released_at">Released at <span class="text-muted">(leave blank if unreleased)</span></label>
            <input type="date" class="form-control" id="released_at" name="released_at" value="<?= $this->escaper->escapeHtml((string) $changelog->released_at) ?>">
          </div>
          <button type="submit" class="btn btn-primary">Create changelog</button>
          <a href="<?= $this->url->get('requirements/changelogs') ?>" class="btn btn-link">Cancel</a>
        </form>
      </div>
    </div>
  </div>
</div>
