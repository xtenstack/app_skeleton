# SQLite data — schema history lives in db/patches/, not the binary db
/db/*.sqlite*

# Generated/runtime
/cache/volt/*
!/cache/volt/.gitkeep
/public/temp/*
!/public/temp/.gitkeep
/public/files/*
!/public/files/.gitkeep
/logs/*
!/logs/.gitkeep
/sessions/*
!/sessions/.gitkeep
/storage/*
!/storage/.gitkeep

# Composer (ext-phalcon itself isn't composer-installable; this is only for
# any regular PHP deps declared in composer.json, e.g. require-dev tooling)
/vendor/

# PHPUnit's own cache/result files (machine-specific, not project config)
/.phpunit.cache/
/.phpunit.result.cache

# php-cs-fixer's own cache file (machine-specific, not project config)
/.php-cs-fixer.cache

# Local Claude Code overrides (auto-accumulated permission grants, machine-specific)
/.claude/settings.local.json

# Phalcon DevTools local log (machine-specific, not project config)
/.phalcon/

# OS
.DS_Store

# Symmetric key for App_skeleton\Crypto (external_connections credentials) —
# auto-generated on first use, back it up separately from the repo/db.
/.encryption_key

# Per-environment overrides (DB credentials, etc.) — never committed, see
# app/config/config.php for how it's merged in.
/app/config/config.local.php

# Per-instance private/internal Composer packages (see docs/INTERNAL-MODULES.md).
# Merged in by wikimedia/composer-merge-plugin if present — copy
# composer.local.json.example to get started. Never committed: this is
# how requirements-module (and any future internal-only module) gets
# pulled in without the public repo hard-requiring it.
/composer.local.json

# Docker Compose local stack — DB creds and stateful volumes (uploads,
# logs, the encryption key), see docker-compose.yml/.env.example.
/.env
/data/

# Database backups (BackupTask / REQ-077) — real dump files, never
# committed.
/backups/

# Scratch task-prompt file staged by the dev droplet's AutoClaudeDev
# runner (xtenstack/internal's bin/autoclaudedev-runner.sh) so the
# sandbox container can read it — always cleaned up after the run, this
# is a belt-and-braces guard in case a run is interrupted mid-flight.
/.autoclaudedev-task-prompt.md
