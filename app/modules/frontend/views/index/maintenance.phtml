<?php if ($maintenanceUntilIso): ?>
<script>
(function () {
  // Client-side ticking rather than a server-refreshed page — this is a
  // static countdown against one fixed target time, so there's nothing a
  // round trip would give us that a local setInterval doesn't, and it
  // keeps ticking even if the tab is left open for hours without
  // hammering the (possibly-down-for-maintenance) server with reloads.
  var el = document.getElementById('maintenance-countdown');
  if (!el) {
    return;
  }

  var target = new Date(el.getAttribute('data-until')).getTime();

  function tick() {
    var diff = target - Date.now();

    if (diff <= 0) {
      el.textContent = 'any moment now';
      return;
    }

    var minutes = Math.floor(diff / 60000);
    var days    = Math.floor(minutes / 1440);
    var hours   = Math.floor((minutes % 1440) / 60);
    var mins    = minutes % 60;

    el.textContent = days + 'd ' + hours + 'h ' + mins + 'm';
  }

  tick();
  setInterval(tick, 30000);
})();
</script>
<?php endif; ?>
