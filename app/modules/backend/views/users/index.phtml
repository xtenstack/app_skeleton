<?php $baseUrl = $this->url->get('backend/users'); ?>
<div class="row mb-2">
  <div class="col-12 d-flex justify-content-between align-items-center">
    <h1>Users</h1>
    <a href="<?= $this->url->get('backend/users/new') ?>" class="btn btn-primary">New user</a>
  </div>
</div>

<div class="row mb-2">
  <div class="col-12">
    <?= \App_skeleton\ListView::searchForm($baseUrl, $listState['q'], $preserveQuery, 'Search email/name…') ?>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-striped mb-0">
          <thead>
            <tr>
              <th><?= \App_skeleton\ListView::sortLink($baseUrl, 'Email', 'email', $listState['sort'], $listState['dir'], $preserveQuery) ?></th>
              <th><?= \App_skeleton\ListView::sortLink($baseUrl, 'Name', 'first_name', $listState['sort'], $listState['dir'], $preserveQuery) ?></th>
              <th>Role</th>
              <th>Active</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
<?php foreach ($users as $user): ?>
            <tr>
              <td><?= $this->escaper->escapeHtml($user->email) ?></td>
              <td><?= $this->escaper->escapeHtml(trim($user->first_name . ' ' . $user->last_name)) ?></td>
              <td><?= $this->escaper->escapeHtml($user->Roles ? $user->Roles->name : '—') ?></td>
              <td><?= $user->is_active ? '<span class="badge badge-success">Active</span>' : '<span class="badge badge-secondary">Inactive</span>' ?></td>
              <td class="text-right">
                <a href="<?= $this->url->get('backend/users/edit/' . $user->id) ?>" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a href="<?= $this->url->get('backend/users/profile/' . $user->id) ?>" class="btn btn-sm btn-outline-secondary">Profile</a>
                <a href="<?= $this->url->get('backend/users/settings/' . $user->id) ?>" class="btn btn-sm btn-outline-secondary">Settings</a>
              </td>
            </tr>
<?php endforeach; ?>
<?php if (!count($users)): ?>
            <tr>
              <td colspan="5" class="text-center text-muted">No users yet.</td>
            </tr>
<?php endif; ?>
          </tbody>
        </table>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="row mt-2">
  <div class="col-12 d-flex justify-content-between align-items-center">
    <span class="text-muted small"><?= $listState['total'] ?> user<?= $listState['total'] === 1 ? '' : 's' ?></span>
    <?= \App_skeleton\ListView::pagination($baseUrl, $listState['page'], $listState['totalPages'], $preserveQuery) ?>
  </div>
</div>
