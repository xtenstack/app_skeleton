  <div class="col-12">
    <div class="card">
      <div class="card-body p-0">
        <table class="table table-striped mb-0">
          <thead>
            <tr>
              <th>Ran at</th>
              <th>Job</th>
              <th>Status</th>
              <th>Output</th>
            </tr>
          </thead>
          <tbody>
<?php foreach ($entries as $entry): ?>
