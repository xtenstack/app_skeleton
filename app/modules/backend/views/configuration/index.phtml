<div class="row mb-2">
  <div class="col-12">
    <h1 class="mb-0">Configuration</h1>
    <p class="text-muted mb-0">Instance-level admin tools. Starts with module management — more will land here over time.</p>
  </div>
</div>

<div class="row mb-4">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title mb-0">Maintenance Mode</h3>
      </div>
      <div class="card-body">
        <p class="text-muted">
          When on, non-admin traffic sees a maintenance page instead of the
          real site. Admins can still sign in and reach every page as
          normal, including this one.
        </p>
        <p class="mb-3">
          Currently:
<?php if ($maintenanceMode): ?>
          <span class="badge badge-warning">On</span>
<?php else: ?>
          <span class="badge badge-secondary">Off</span>
<?php endif; ?>
<?php if ($maintenanceMode && $maintenanceModeUntil): ?>
          &mdash; until <?= $this->escaper->escapeHtml(date('j M Y, g:i A', strtotime($maintenanceModeUntil))) ?>
<?php endif; ?>
        </p>
        <form method="post" action="<?= $this->url->get('backend/configuration/maintenance') ?>" class="form-inline">
          <div class="form-group mr-3 mb-2">
            <label for="maintenance_mode_until" class="mr-2">Until</label>
            <input
              type="datetime-local"
              class="form-control"
              id="maintenance_mode_until"
              name="maintenance_mode_until"
              value="<?= $this->escaper->escapeHtmlAttr($maintenanceModeUntil ? date('Y-m-d\TH:i', strtotime($maintenanceModeUntil)) : '') ?>"
            >
          </div>
<?php if ($maintenanceMode): ?>
          <input type="hidden" name="maintenance_mode" value="0">
          <button type="submit" class="btn btn-outline-secondary mb-2">Turn off</button>
<?php else: ?>
          <input type="hidden" name="maintenance_mode" value="1">
          <button type="submit" class="btn btn-warning mb-2">Turn on</button>
<?php endif; ?>
        </form>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h3 class="card-title mb-0">Modules</h3>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-striped mb-0">
          <thead>
            <tr>
              <th>Key</th>
              <th>Code</th>
              <th>Tier</th>
              <th>Version</th>
              <th>Status</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
<?php foreach ($modules as $module): ?>
            <tr>
              <td><code><?= $this->escaper->escapeHtml($module->module_key) ?></code></td>
              <td><?= $this->escaper->escapeHtml((string) $module->code) ?></td>
              <td><?= $this->escaper->escapeHtml($module->tier) ?></td>
              <td><?= $this->escaper->escapeHtml((string) $module->version) ?></td>
              <td>
<?php if ($module->enabled): ?>
                <span class="badge badge-success">Enabled</span>
<?php else: ?>
                <span class="badge badge-secondary">Disabled</span>
<?php endif; ?>
              </td>
              <td class="text-right">
<?php if ($module->enabled): ?>
                <form method="post" action="<?= $this->url->get('backend/configuration/disable/' . $module->module_key) ?>">
                  <button type="submit" class="btn btn-sm btn-outline-secondary">Disable</button>
                </form>
<?php else: ?>
                <form method="post" action="<?= $this->url->get('backend/configuration/enable/' . $module->module_key) ?>">
                  <button type="submit" class="btn btn-sm btn-primary">Enable</button>
                </form>
<?php endif; ?>
              </td>
            </tr>
<?php endforeach; ?>
<?php if (!count($modules)): ?>
            <tr>
              <td colspan="6" class="text-center text-muted">
                No modules discovered yet — install a module package via Composer, then run <code>./run modules sync</code>.
              </td>
            </tr>
<?php endif; ?>
          </tbody>
        </table>
        </div>
      </div>
    </div>
  </div>
</div>
