<div class="row mb-2">
  <div class="col-12">
    <h1>Edit ticket #<?= $ticket->id ?></h1>
  </div>
</div>

<div class="row">
  <div class="col-12 col-md-6">
    <div class="card">
      <div class="card-body">
        <form method="post" action="<?= $this->url->get('backend/tickets/update/' . $ticket->id) ?>">
          <div class="form-group">
            <label for="title">Title</label>
            <input type="text" class="form-control" id="title" name="title" value="<?= $this->escaper->escapeHtml((string) $ticket->title) ?>" required>
          </div>
          <div class="form-group">
            <label class="d-block">Type</label>
<?php foreach (['bug' => 'Bug', 'issue' => 'Issue', 'feature' => 'Feature', 'support' => 'Support'] as $value => $label): ?>
            <div class="form-check form-check-inline">
              <input class="form-check-input" type="radio" name="ticket_type" id="ticket_type_<?= $value ?>" value="<?= $value ?>" <?= ($ticket->ticket_type ?: 'bug') === $value ? 'checked' : '' ?>>
              <label class="form-check-label" for="ticket_type_<?= $value ?>"><?= $label ?></label>
            </div>
<?php endforeach; ?>
          </div>
          <div class="form-group">
            <label for="severity">Severity</label>
            <select class="form-control" id="severity" name="severity">
<?php foreach (['low' => 'Low', 'normal' => 'Normal', 'high' => 'High', 'critical' => 'Critical'] as $value => $label): ?>
              <option value="<?= $value ?>" <?= ($ticket->severity ?: 'normal') === $value ? 'selected' : '' ?>><?= $label ?></option>
<?php endforeach; ?>
            </select>
          </div>
          <div class="form-group">
            <label for="description">Description</label>
            <textarea class="form-control" id="description" name="description" rows="5"><?= $this->escaper->escapeHtml((string) $ticket->description) ?></textarea>
          </div>
          <div class="form-group">
            <label for="notes">Internal notes <span class="text-muted">(staff only, not visible via the API)</span></label>
            <textarea class="form-control" id="notes" name="notes" rows="4"><?= $this->escaper->escapeHtml((string) $ticket->notes) ?></textarea>
          </div>
          <button type="submit" class="btn btn-primary">Save changes</button>
          <a href="<?= $this->url->get('backend/tickets/view/' . $ticket->id) ?>" class="btn btn-link">Cancel</a>
        </form>
      </div>
    </div>
  </div>
</div>
