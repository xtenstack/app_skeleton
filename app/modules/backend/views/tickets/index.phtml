<?php $baseUrl = $this->url->get('backend/tickets'); ?>
<div class="row mb-2">
  <div class="col-12">
    <h1>Tickets</h1>
  </div>
</div>

<?php if ($needsQaCount > 0): ?>
<div class="row mb-2">
  <div class="col-12">
    <div class="alert alert-warning d-flex justify-content-between align-items-center mb-0">
      <span><?= $needsQaPercent ?>% of auto-closed tickets this week haven't been spot-checked yet (<?= $needsQaCount ?> ticket<?= $needsQaCount === 1 ? '' : 's' ?>).</span>
      <a href="<?= $baseUrl ?>?filter=needs_qa" class="btn btn-sm btn-warning">Review now</a>
    </div>
  </div>
</div>
<?php endif; ?>

<div class="row mb-2">
  <div class="col-12">
    <div class="btn-group" role="group">
      <a href="<?= $baseUrl ?>" class="btn btn-sm btn-outline-secondary <?= $currentFilter === '' && $currentStatus === '' ? 'active' : '' ?>">All</a>
      <a href="<?= $baseUrl ?>?status=open" class="btn btn-sm btn-outline-secondary <?= $currentStatus === 'open' ? 'active' : '' ?>">Open</a>
      <a href="<?= $baseUrl ?>?status=in_review" class="btn btn-sm btn-outline-secondary <?= $currentStatus === 'in_review' ? 'active' : '' ?>">In review</a>
      <a href="<?= $baseUrl ?>?status=consolidated" class="btn btn-sm btn-outline-secondary <?= $currentStatus === 'consolidated' ? 'active' : '' ?>">Consolidated</a>
      <a href="<?= $baseUrl ?>?status=closed" class="btn btn-sm btn-outline-secondary <?= $currentStatus === 'closed' ? 'active' : '' ?>">Closed</a>
      <a href="<?= $baseUrl ?>?filter=needs_qa" class="btn btn-sm btn-outline-secondary <?= $currentFilter === 'needs_qa' ? 'active' : '' ?>">Needs QA</a>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-body p-0">
        <table class="table table-striped mb-0">
          <thead>
            <tr>
              <th>#</th>
              <th>Title</th>
              <th>Severity</th>
              <th>Status</th>
              <th>Reporter</th>
              <th>Assignee</th>
              <th>Created</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
<?php foreach ($tickets as $ticket): ?>
            <tr>
              <td><?= $ticket->id ?></td>
              <td><?= $this->escaper->escapeHtml($ticket->title) ?></td>
              <td><span class="badge badge-<?= $ticket->severity === 'critical' ? 'danger' : ($ticket->severity === 'high' ? 'warning' : 'secondary') ?>"><?= $this->escaper->escapeHtml($ticket->severity) ?></span></td>
              <td><span class="badge badge-<?= $ticket->status === 'closed' ? 'success' : ($ticket->status === 'consolidated' ? 'secondary' : ($ticket->status === 'in_review' ? 'info' : 'primary')) ?>"><?= $this->escaper->escapeHtml($ticket->status) ?></span>
<?php if ($ticket->auto_closed_at && !$ticket->qa_reviewed_at): ?>
                <span class="badge badge-warning">needs QA</span>
<?php endif; ?>
              </td>
              <td><?= $this->escaper->escapeHtml($ticket->Reporter ? $ticket->Reporter->email : '—') ?></td>
              <td><?= $this->escaper->escapeHtml($ticket->Assignee ? $ticket->Assignee->email : '—') ?></td>
              <td><?= $this->escaper->escapeHtml($ticket->created_at) ?></td>
              <td class="text-right">
                <a href="<?= $this->url->get('backend/tickets/view/' . $ticket->id) ?>" class="btn btn-sm btn-outline-secondary">View</a>
              </td>
            </tr>
<?php endforeach; ?>
<?php if (!count($tickets)): ?>
            <tr>
              <td colspan="8" class="text-center text-muted">No tickets yet.</td>
            </tr>
<?php endif; ?>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
