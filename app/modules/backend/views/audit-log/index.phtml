<?php $baseUrl = $this->url->get('backend/audit-log'); ?>
<div class="row mb-2">
  <div class="col-12">
    <h1>Audit Log</h1>
    <p class="text-muted mb-0">Read-only — entries are immutable by design, no edit or delete.</p>
  </div>
</div>

<div class="row mb-2">
  <div class="col-12">
    <?= \App_skeleton\ListView::searchForm($baseUrl, $listState['q'], $preserveQuery, 'Search entity/action…') ?>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-striped mb-0">
          <thead>
            <tr>
              <th><?= \App_skeleton\ListView::sortLink($baseUrl, 'When', 'created', $listState['sort'], $listState['dir'], $preserveQuery) ?></th>
              <th><?= \App_skeleton\ListView::sortLink($baseUrl, 'Entity', 'entity_type', $listState['sort'], $listState['dir'], $preserveQuery) ?></th>
              <th><?= \App_skeleton\ListView::sortLink($baseUrl, 'Action', 'action', $listState['sort'], $listState['dir'], $preserveQuery) ?></th>
              <th>Actor</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
<?php foreach ($entries as $entry): ?>
            <tr>
              <td><?= $this->escaper->escapeHtml($entry->created_at) ?></td>
              <td><?= $this->escaper->escapeHtml($entry->entity_type) ?><?= $entry->entity_id ? ' #' . $entry->entity_id : '' ?></td>
              <td><span class="badge badge-<?= $entry->action === 'delete' ? 'danger' : ($entry->action === 'insert' ? 'success' : 'info') ?>"><?= $this->escaper->escapeHtml($entry->action) ?></span></td>
              <td><?= $this->escaper->escapeHtml($entry->Users ? $entry->Users->email : 'System / unknown') ?></td>
              <td class="text-right">
                <a href="<?= $this->url->get('backend/audit-log/view/' . $entry->id) ?>" class="btn btn-sm btn-outline-secondary">Details</a>
              </td>
            </tr>
<?php endforeach; ?>
<?php if (!count($entries)): ?>
            <tr>
              <td colspan="5" class="text-center text-muted">No audit entries yet.</td>
            </tr>
<?php endif; ?>
          </tbody>
        </table>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="row mt-2">
  <div class="col-12 d-flex justify-content-between align-items-center">
    <span class="text-muted small"><?= $listState['total'] ?> entr<?= $listState['total'] === 1 ? 'y' : 'ies' ?></span>
    <?= \App_skeleton\ListView::pagination($baseUrl, $listState['page'], $listState['totalPages'], $preserveQuery) ?>
  </div>
</div>
