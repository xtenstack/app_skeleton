<?php
/** @var \Phalcon\Mvc\View\Engine\Php $this */
$controllerName = $this->dispatcher->getControllerName();
$isGuestLanding = $controllerName === 'index' && !$this->session->has('auth');
$isAuthPage = $isGuestLanding || in_array($controllerName, ['session', 'signup', 'password'], true);

/**
 * Effective theme: the logged-in user's own preference (session-cached
 * user_settings, see Auth::check()), falling back to the admin-set global
 * default, falling back to a hardcoded default — so a missing/corrupt
 * setting never breaks the page, it just falls through to blue/auto.
 */
$allowedPalettes = ['blue', 'purple', 'green', 'orange', 'stack'];
$allowedModes    = ['light', 'dark', 'auto'];
$userSettings    = $this->session->get('user_settings') ?? [];
$themePalette    = $userSettings['theme_palette'] ?? $this->settings->get('default_theme_palette', 'blue');
$themeMode       = $userSettings['theme_mode'] ?? $this->settings->get('default_theme_mode', 'auto');

if (!in_array($themePalette, $allowedPalettes, true)) {
    $themePalette = 'blue';
}

if (!in_array($themeMode, $allowedModes, true)) {
    $themeMode = 'auto';
}

$isAdmin     = ((int) ($this->session->get('auth')['role_id'] ?? 0)) === 1;
$debugActive = !$isAuthPage && $isAdmin && $this->settings->get('debug_mode', '0') === '1';
?>
<!DOCTYPE html>
<html lang="en" data-palette="<?= $this->escaper->escapeHtmlAttr($themePalette) ?>" data-mode="<?= $this->escaper->escapeHtmlAttr($themeMode) ?>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?= $this->escaper->escapeHtml($this->settings->get('site_name', 'App Skeleton')) ?> — Backend</title>
    <meta name="csrf-key" content="<?= $this->escaper->escapeHtml($this->security->getTokenKey()) ?>">
    <meta name="csrf-token" content="<?= $this->escaper->escapeHtml($this->security->getToken()) ?>">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="stylesheet" href="/assets/adminlte/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="/assets/adminlte/css/adminlte.min.css">
    <link rel="stylesheet" href="/assets/css/theme.css">
  </head>
  <body class="<?= $isGuestLanding ? 'hold-transition' : ($isAuthPage ? 'hold-transition login-page' : 'sidebar-mini layout-fixed') ?>">
<?php
/**
 * Phalcon\Flash\Session::output() returns an empty string in this build even
 * though getMessages() reports the queued messages correctly, so render them
 * by hand instead of relying on it. Rendered on every page (auth pages
 * included) so redirects into session/signup/password — e.g. a rejected
 * CSRF check — actually surface their flash message.
 */
$flashTypeClasses = [
    'success' => 'alert-success',
    'error'   => 'alert-danger',
    'notice'  => 'alert-info',
    'warning' => 'alert-warning',
];
$flashHtml = '';
foreach ($this->flash->getMessages() as $flashType => $flashMessages) {
    foreach ($flashMessages as $flashMessage) {
        $flashHtml .= '<div class="alert alert-dismissible fade show ' . ($flashTypeClasses[$flashType] ?? 'alert-secondary') . '">'
            . '<button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>'
            . $this->escaper->escapeHtml($flashMessage)
            . '</div>';
    }
}
$this->flash->clear();
?>
<?php if ($isAuthPage): ?>
    <?= $flashHtml ?>
    <?= $this->getContent() ?>
<?php else: ?>
    <div class="wrapper">
      <?= $this->partial('partials/topnav') ?>

      <?= $this->partial('partials/sidenav', ['controllerName' => $controllerName]) ?>

      <div class="content-wrapper">
        <div class="content">
          <div class="container-fluid">
            <?= $flashHtml ?>
            <?= $this->getContent() ?>
          </div>
        </div>
      </div>

      <?= $this->partial('partials/footer') ?>
    </div>
<?php endif; ?>

    <script src="/assets/adminlte/plugins/jquery/jquery.min.js"></script>
    <script src="/assets/adminlte/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/adminlte/js/adminlte.min.js"></script>
    <!-- bfcache-reload + CSRF auto-injection — see public/assets/js/app.js
         (extracted from inline, Session 13, so script-src can drop
         'unsafe-inline' from the CSP). -->
    <script src="/assets/js/app.js"></script>
<?php if ($debugActive): ?>
    <?= $this->partial('partials/debugbar') ?>
<?php endif; ?>
  </body>
</html>
