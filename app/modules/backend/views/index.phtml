        <div class="content">
          <div class="container-fluid">
<?php
/**
 * Phalcon\Flash\Session::output() returns an empty string in this build even
 * though getMessages() reports the queued messages correctly, so render them
 * by hand instead of relying on it.
 */
$flashTypeClasses = [
    'success' => 'alert-success',
    'error'   => 'alert-danger',
    'notice'  => 'alert-info',
    'warning' => 'alert-warning',
];
foreach ($this->flash->getMessages() as $flashType => $flashMessages):
    foreach ($flashMessages as $flashMessage): ?>
            <div class="alert <?= $flashTypeClasses[$flashType] ?? 'alert-secondary' ?>"><?= $this->escaper->escapeHtml($flashMessage) ?></div>
<?php
    endforeach;
endforeach;
$this->flash->clear();
?>
            <?= $this->getContent() ?>
          </div>
        </div>
      </div>
    </div>
<?php endif; ?>

