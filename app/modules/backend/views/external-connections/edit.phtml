<div class="row mb-2">
  <div class="col-12">
    <h1>Edit external connection</h1>
  </div>
</div>

<div class="row">
  <div class="col-12 col-md-6">
    <div class="card">
      <div class="card-body">
        <form method="post" action="<?= $this->url->get('backend/external-connections/save') ?>">
          <input type="hidden" name="id" value="<?= $connection->id ?>">
          <div class="form-group">
            <label for="name">Name</label>
            <input type="text" class="form-control" id="name" name="name" value="<?= $this->escaper->escapeHtml($connection->name) ?>" required>
          </div>
          <div class="form-group">
            <label for="base_url">Base URL</label>
            <input type="text" class="form-control" id="base_url" name="base_url" value="<?= $this->escaper->escapeHtml((string) $connection->base_url) ?>">
          </div>
          <div class="form-group">
            <label for="auth_type">Auth type</label>
            <select class="form-control" id="auth_type" name="auth_type">
<?php foreach ($authTypes as $type): ?>
              <option value="<?= $type ?>" <?= $connection->auth_type === $type ? 'selected' : '' ?>><?= $type ?></option>
<?php endforeach; ?>
            </select>
          </div>
          <div class="form-group">
            <label for="credential">Credential (API key / token / secret)</label>
            <div class="input-group">
              <input type="password" class="form-control" id="credential" name="credential" autocomplete="new-password" placeholder="Leave blank to keep the current credential">
              <div class="input-group-append">
                <button type="button" class="btn btn-outline-secondary" id="revealBtn" data-url="<?= $this->url->get('backend/external-connections/reveal/' . $connection->id) ?>">Reveal current</button>
              </div>
            </div>
            <small class="form-text text-muted">Stored encrypted at rest. Revealing decrypts it for this page view only.</small>
          </div>
          <div class="form-group">
            <label for="config">Config (JSON, optional)</label>
            <textarea class="form-control" id="config" name="config" rows="4"><?= $this->escaper->escapeHtml((string) $connection->config) ?></textarea>
          </div>
          <div class="form-group form-check">
            <input type="checkbox" class="form-check-input" id="is_active" name="is_active" value="1" <?= $connection->is_active ? 'checked' : '' ?>>
            <label class="form-check-label" for="is_active">Active</label>
          </div>
          <button type="submit" class="btn btn-primary">Save</button>
          <a href="<?= $this->url->get('backend/external-connections') ?>" class="btn btn-link">Cancel</a>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
document.getElementById('revealBtn').addEventListener('click', function () {
  var btn = this;
  fetch(btn.dataset.url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
    .then(function (r) { return r.json(); })
    .then(function (data) {
      document.getElementById('credential').type = 'text';
      document.getElementById('credential').value = data.credential || '';
      document.getElementById('credential').placeholder = data.credential ? '' : 'No credential stored';
      btn.disabled = true;
    });
});
</script>
