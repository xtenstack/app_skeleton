    <a href="<?= $this->url->get('backend/settings/new') ?>" class="btn btn-primary">New setting</a>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-body p-0">
        <table class="table table-striped mb-0">
          <thead>
            <tr>
              <th>Key</th>
              <th>Value</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
<?php foreach ($settings as $setting): ?>
            <tr>
              <td><?= $this->escaper->escapeHtml($setting->setting_key) ?></td>
              <td><?= $this->escaper->escapeHtml($setting->setting_value) ?></td>
              <td class="text-right">
                <a href="<?= $this->url->get('backend/settings/edit/' . $setting->id) ?>" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a href="<?= $this->url->get('backend/settings/delete/' . $setting->id) ?>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this setting?')">Delete</a>
