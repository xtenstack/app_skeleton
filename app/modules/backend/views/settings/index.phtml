<?php $baseUrl = $this->url->get('backend/settings'); ?>
<div class="row mb-2">
  <div class="col-12 d-flex justify-content-between align-items-center">
    <h1>Settings</h1>
    <a href="<?= $this->url->get('backend/settings/new') ?>" class="btn btn-primary">New setting</a>
  </div>
</div>

<div class="row mb-2">
  <div class="col-12">
    <?= \App_skeleton\ListView::searchForm($baseUrl, $listState['q'], $preserveQuery, 'Search key/value…') ?>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table table-striped mb-0">
          <thead>
            <tr>
              <th><?= \App_skeleton\ListView::sortLink($baseUrl, 'Key', 'key', $listState['sort'], $listState['dir'], $preserveQuery) ?></th>
              <th>Value</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
<?php foreach ($settings as $setting): ?>
            <tr>
              <td><?= $this->escaper->escapeHtml($setting->setting_key) ?></td>
              <td><?= $this->escaper->escapeHtml($setting->setting_value) ?></td>
              <td class="text-right">
                <a href="<?= $this->url->get('backend/settings/edit/' . $setting->id) ?>" class="btn btn-sm btn-outline-secondary">Edit</a>
                <form method="post" action="<?= $this->url->get('backend/settings/delete/' . $setting->id) ?>" class="d-inline" onsubmit="return confirm('Delete this setting?')">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              </td>
            </tr>
<?php endforeach; ?>
<?php if (!count($settings)): ?>
            <tr>
              <td colspan="3" class="text-center text-muted">No settings yet.</td>
            </tr>
<?php endif; ?>
          </tbody>
        </table>
        </div>
      </div>
    </div>
  </div>
</div>
<div class="row mt-2">
  <div class="col-12 d-flex justify-content-between align-items-center">
    <span class="text-muted small"><?= $listState['total'] ?> setting<?= $listState['total'] === 1 ? '' : 's' ?></span>
    <?= \App_skeleton\ListView::pagination($baseUrl, $listState['page'], $listState['totalPages'], $preserveQuery) ?>
  </div>
</div>
