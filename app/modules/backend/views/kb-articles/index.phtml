// Enquiry-type filter: same link-group shape as the status filter above,
// each link keeping whatever status/search is already active (and vice
// versa the status links above are deliberately plain — they reset the
// type, matching Tickets' "All" behaviour). Plain GET links, no JS.
$typeFilterBase = array_filter(['status' => $currentStatus, 'q' => $listState['q']], fn ($v) => $v !== '' && $v !== null);
$typeLink       = fn (?int $typeId) => $baseUrl . (($qs = http_build_query($typeFilterBase + ($typeId ? ['enquiry_type_id' => $typeId] : []))) !== '' ? '?' . $qs : '');
?>
<div class="row mb-2">
  <div class="col-12">
    <span class="text-muted small mr-2">Enquiry type:</span>
    <div class="btn-group flex-wrap" role="group" aria-label="Filter by enquiry type">
      <a href="<?= $this->escaper->escapeHtmlAttr($typeLink(null)) ?>" class="btn btn-sm btn-outline-secondary <?= !$enquiryTypeId ? 'active' : '' ?>">All</a>
<?php foreach ($enquiryTypes as $enquiryType): ?>
      <a href="<?= $this->escaper->escapeHtmlAttr($typeLink((int) $enquiryType->id)) ?>" class="btn btn-sm btn-outline-secondary <?= (int) $enquiryTypeId === (int) $enquiryType->id ? 'active' : '' ?>"><?= $this->escaper->escapeHtml($enquiryType->name) ?></a>
<?php endforeach; ?>
    </div>
  </div>
</div>

