{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/safety-guard.sh",
            "statusMessage": "Checking command against safety-guard patterns..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.php) php85 vendor/bin/php-cs-fixer fix \"$f\" > /dev/null 2>&1 ;; esac; } || true",
            "statusMessage": "Auto-formatting PHP file..."
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MSG=$(jq -r '.message // \"Claude Code needs your attention\"' 2>/dev/null); osascript -e \"display notification \\\"$MSG\\\" with title \\\"Claude Code\\\" sound name \\\"Glass\\\"\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/precompact-log.sh",
            "statusMessage": "Logging compaction event..."
          }
        ]
      }
    ]
  }
}
